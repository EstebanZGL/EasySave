<Window x:Class="EasySave.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.Views"
        xmlns:vm="clr-namespace:EasySave.ViewModels"
        xmlns:converters="clr-namespace:EasySave.Converters"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" Height="600" Width="1000">
    
    <Window.Resources>
        <!-- Converter to change null to false and non-null to true -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with settings -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="EasySave 2.0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding LogFormatLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Width="80" Margin="0,0,10,0" 
                          SelectedValue="{Binding SelectedLogFormat}" 
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="JSON"/>
                    <ComboBoxItem Content="XML"/>
                </ComboBox>
                
                <Button Content="{Binding SelectedLanguage}" Command="{Binding ChangeLanguageCommand}" Width="50" Margin="0,0,10,0"/>
                <Button Content="{Binding SettingsButtonText}" Command="{Binding OpenSettingsCommand}" Width="80"/>
            </StackPanel>
        </Grid>
        
        <!-- Main content area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Backup jobs list -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,5,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsAllJobsSelected}" Content="{Binding SelectAllText}" 
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding BackupJobsHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                    <ListView ItemsSource="{Binding BackupJobs}" SelectedItem="{Binding SelectedBackupJob}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding DataContext.NameLabel, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="120" DisplayMemberBinding="{Binding JobName}"/>
                                <GridViewColumn Header="{Binding DataContext.SourcePathLabel, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="150" DisplayMemberBinding="{Binding SourcePath}"/>
                                <GridViewColumn Header="{Binding DataContext.TargetPathLabel, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="150" DisplayMemberBinding="{Binding TargetPath}"/>
                                <GridViewColumn Header="{Binding DataContext.TypeLabel, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="80" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="{Binding DataContext.LastBackupLabel, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="150" DisplayMemberBinding="{Binding LastBackupTimeDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
            
            <!-- Details and actions panel -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{Binding BackupJobDetailsHeader}" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding NameLabel}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.JobName, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="{Binding SourcePathLabel}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.SourcePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="{Binding TargetPathLabel}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.TargetPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.Type, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="{Binding LastBackupLabel}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.LastBackupTimeDisplay, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,10,0,10" Padding="0,10,0,0">
                                <TextBlock Text="{Binding JobStatusLabel}" FontWeight="SemiBold"/>
                            </Border>
                            
                            <!-- This would be populated with real-time status in a full implementation -->
                            <ProgressBar Height="20" Value="0" Margin="0,5,0,5"/>
                            <TextBlock Text="{Binding NotRunningText}" Margin="0,0,0,10"/>
                            
                            <!-- Additional status information would go here -->
                        </StackPanel>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2">
                        <Button Content="{Binding ExecuteButtonText}" 
                                Command="{Binding ExecuteBackupJobCommand}" 
                                Margin="0,0,0,10" Padding="5"
                                IsEnabled="{Binding SelectedBackupJob, Converter={StaticResource NullToBoolConverter}}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Content="{Binding EditButtonText}" 
                                    Command="{Binding EditBackupJobCommand}" 
                                    Margin="0,0,5,0" Padding="5"/>
                            
                            <Button Grid.Column="1" Content="{Binding DeleteButtonText}" 
                                    Command="{Binding DeleteBackupJobCommand}" 
                                    Margin="5,0,0,0" Padding="5"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5">
            <Button Content="{Binding CreateButtonText}" Command="{Binding CreateBackupJobCommand}" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="{Binding ExecuteSelectedJobsText}" Command="{Binding ExecuteSelectedJobsCommand}" Padding="10,5"
                    IsEnabled="{Binding HasSelectedJobs}"/>
        </StackPanel>
        
        <!-- Status bar -->
        <Border Grid.Row="3" Background="{Binding IsBusinessSoftwareRunning, Converter={StaticResource BoolToColorConverter}}" 
                BorderBrush="Gray" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="10,5" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>