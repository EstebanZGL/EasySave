<Window x:Class="EasySave.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:EasySave.Converters"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Icon="/EasySave;component/Resources/easysave_cloud.ico"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Height="680"
        Width="1140"
        MinHeight="360"
        MinWidth="560"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#F6F7F5">
    <Window.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <SolidColorBrush x:Key="PrimaryGreen" Color="#4C805B"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#AFC5B5"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F3F5F3"/>

        <Style TargetType="Border" x:Key="RoundedPanel">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E36B5E"/>
            <Setter Property="BorderBrush" Value="#E36B5E"/>
        </Style>

        <Style TargetType="Button" x:Key="CopyPathButtonStyle">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ReadOnlyDataBoxStyle">
            <Setter Property="Background" Value="#D0DFD6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="JobStatusRow" Height="230" MinHeight="56"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderPanel" Grid.Row="0" Style="{StaticResource RoundedPanel}" Margin="0,0,0,10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LogoHost" Width="140" Height="70" Margin="0,0,18,0" Background="Transparent">
                        <Image Source="/EasySave;component/Resources/easysave_logo_trimmed.png"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    </Border>
                    <Button x:Name="CreateJobButton" Command="{Binding CreateBackupJobCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="290" Height="56">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#3B694A"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CreatePlusText"
                                           Text="+"
                                           FontSize="24"
                                           FontWeight="Black"
                                           Foreground="White"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Width="30"
                                           LineHeight="30"
                                           Margin="0,-1,0,0"/>
                            </Border>
                            <TextBlock x:Name="CreateLabelText" Text="{Binding CreateButtonText}" FontSize="18"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="SettingsButton" Grid.Column="1"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="{Binding SettingsButtonText}"
                        Width="50"
                        Height="50"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="24"
                        Content="&#xE713;"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*"/>
                <ColumnDefinition Width="1.88*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="BackupJobsPanel" Grid.Column="0" Style="{StaticResource RoundedPanel}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="BackupJobsTitle" Grid.Row="0" Text="{Binding BackupJobsHeader}" FontSize="20" FontWeight="Bold" Margin="8,4,8,6"/>

                    <CheckBox x:Name="SelectAllCheckBox" Grid.Row="1"
                              Content="{Binding SelectAllText}"
                              IsChecked="{Binding IsAllJobsSelected}"
                              Margin="8,0,8,8"
                              FontSize="14"/>

                    <ListView Grid.Row="2"
                              x:Name="BackupJobsListView"
                              ItemsSource="{Binding BackupJobs}"
                              SelectedItem="{Binding SelectedBackupJob}"
                              SelectionMode="Extended"
                              SelectionChanged="BackupJobsListView_SelectionChanged"
                              SizeChanged="BackupJobsListView_SizeChanged"
                              IsSynchronizedWithCurrentItem="False"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AlternationCount="2">
                        <ListView.Resources>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="#ECEFEB"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#E4E7E4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="SelectColumn" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="NameColumn" Header="{Binding DataContext.NameLabel, RelativeSource={RelativeSource AncestorType=Window}}" Width="260" DisplayMemberBinding="{Binding JobName}"/>
                                <GridViewColumn x:Name="LastBackupColumn" Header="{Binding DataContext.LastBackupLabel, RelativeSource={RelativeSource AncestorType=Window}}" Width="300" DisplayMemberBinding="{Binding LastBackupTimeDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Button x:Name="ExecuteSelectedButton" Grid.Row="3"
                            Content="{Binding ExecuteSelectedJobsText}"
                            Command="{Binding ExecuteSelectedJobsCommand}"
                            IsEnabled="{Binding HasSelectedJobs}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,8,8,4"
                            Height="40"
                            FontSize="14"/>
                </Grid>
            </Border>

            <Border x:Name="DetailsPanel" Grid.Column="1" Style="{StaticResource RoundedPanel}" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding BackupJobDetailsHeader}" FontSize="26" FontWeight="Bold" Margin="8,4,8,6"/>
                    <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CreatedLabel}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SelectedBackupJob.CreatedAtDisplay, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyDataBoxStyle}"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="8,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="290"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding NameLabel}" FontSize="14" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedBackupJob.JobName, Mode=OneWay}" Style="{StaticResource ReadOnlyDataBoxStyle}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="14" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedBackupJob.Type, Mode=OneWay}" Style="{StaticResource ReadOnlyDataBoxStyle}" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="8,8,8,0">
                        <TextBlock Text="{Binding SourcePathLabel}" FontSize="14" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SelectedBackupJob.SourcePath, Mode=OneWay}" Style="{StaticResource ReadOnlyDataBoxStyle}" FontSize="14"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource CopyPathButtonStyle}"
                                    Content="&#xE8C8;"
                                    ToolTip="Copy source path"
                                    Click="CopySourcePathButton_Click"
                                    IsEnabled="{Binding SelectedBackupJob, Converter={StaticResource NullToBoolConverter}}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="8,8,8,0">
                        <TextBlock Text="{Binding TargetPathLabel}" FontSize="14" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SelectedBackupJob.TargetPath, Mode=OneWay}" Style="{StaticResource ReadOnlyDataBoxStyle}" FontSize="14"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource CopyPathButtonStyle}"
                                    Content="&#xE8C8;"
                                    ToolTip="Copy target path"
                                    Click="CopyTargetPathButton_Click"
                                    IsEnabled="{Binding SelectedBackupJob, Converter={StaticResource NullToBoolConverter}}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding DescriptionLabel}" FontSize="14" Margin="8,8,8,4"/>

                    <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="8,4,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBox Text="{Binding SelectedBackupJob.Description, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyDataBoxStyle}"
                                     FontSize="14"
                                     MinHeight="88"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Button Content="{Binding EditButtonText}"
                                    Command="{Binding EditBackupJobCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,0,10"
                                    Height="38"
                                    FontSize="14"
                                    Width="150"/>
                            <Button Content="{Binding DeleteButtonText}"
                                    Command="{Binding DeleteBackupJobCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Height="38"
                                    FontSize="14"
                                    Width="150"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter x:Name="JobStatusSplitter"
                      Grid.Row="2"
                      Height="8"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="#D4DED5"
                      ShowsPreview="True"
                      DragCompleted="JobStatusSplitter_DragCompleted"/>

        <Border x:Name="JobStatusPanel" Grid.Row="3" Style="{StaticResource RoundedPanel}" Margin="0,2,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ActiveJobsHeader}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="JobStatusToggleButton"
                            Grid.Column="1"
                            Width="34"
                            Height="30"
                            Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="JobStatusToggleButton_Click"
                            ToolTip="Afficher / masquer l'état du travail"
                            Content="▴"/>
                </Grid>

                <ListView x:Name="JobStatusListView" ItemsSource="{Binding ActiveJobs}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding DataContext.NameLabel, RelativeSource={RelativeSource AncestorType=Window}}" Width="160" DisplayMemberBinding="{Binding JobName}"/>
                            <GridViewColumn Header="{Binding DataContext.JobStatusLabel, RelativeSource={RelativeSource AncestorType=Window}}" Width="150" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="{Binding DataContext.CurrentFileLabel, RelativeSource={RelativeSource AncestorType=Window}}" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFile}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding DataContext.ProgressLabel, RelativeSource={RelativeSource AncestorType=Window}}" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="170">
                                            <ProgressBar Value="{Binding Progress}" Height="16"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Pause / Stop" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{Binding PauseResumeButtonText}"
                                                    Command="{Binding DataContext.PauseResumeJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding JobName}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Width="82"
                                                    Height="30"
                                                    FontSize="12"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="{Binding StopButtonText}"
                                                    Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding JobName}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Width="82"
                                                    Height="30"
                                                    FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Padding="10,5"
                CornerRadius="12"
                Background="{Binding IsBusinessSoftwareRunning, Converter={StaticResource BoolToColorConverter}}">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="12"/>
        </Border>
    </Grid>
</Window>
