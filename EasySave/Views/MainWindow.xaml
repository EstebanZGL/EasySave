<Window x:Class="EasySave.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.Views"
        xmlns:vm="clr-namespace:EasySave.ViewModels"
        xmlns:converters="clr-namespace:EasySave.Converters"
        mc:Ignorable="d"
        Title="EasySave 2.0" Height="600" Width="900">
    
    <Window.Resources>
        <!-- Converter to change null to false and non-null to true -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with settings -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="EasySave 2.0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Log Format:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Width="80" Margin="0,0,10,0" SelectedItem="{Binding SelectedLogFormat}">
                    <ComboBoxItem Content="JSON"/>
                    <ComboBoxItem Content="XML"/>
                </ComboBox>
                
                <Button Content="{Binding SelectedLanguage}" Command="{Binding ChangeLanguageCommand}" Width="50" Margin="0,0,10,0"/>
                <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Width="80"/>
            </StackPanel>
        </Grid>
        
        <!-- Main content area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Backup jobs list -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,5,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Backup Jobs" FontWeight="Bold" Margin="10,5"/>
                    <ListView ItemsSource="{Binding BackupJobs}" SelectedItem="{Binding SelectedBackupJob}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Source" Width="180" DisplayMemberBinding="{Binding SourcePath}"/>
                                <GridViewColumn Header="Target" Width="180" DisplayMemberBinding="{Binding TargetPath}"/>
                                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
            
            <!-- Details and actions panel -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Backup Job Details" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Name:" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.Name, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Source Path:" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.SourcePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Target Path:" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.TargetPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Type:" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedBackupJob.Type, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"/>
                            
                            <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,10,0,10" Padding="0,10,0,0">
                                <TextBlock Text="Job Status" FontWeight="SemiBold"/>
                            </Border>
                            
                            <!-- This would be populated with real-time status in a full implementation -->
                            <ProgressBar Height="20" Value="0" Margin="0,5,0,5"/>
                            <TextBlock Text="Not running" Margin="0,0,0,10"/>
                            
                            <!-- Additional status information would go here -->
                        </StackPanel>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2">
                        <Button Content="Execute Backup" 
                                Command="{Binding ExecuteBackupJobCommand}" 
                                Margin="0,0,0,10" Padding="5"
                                IsEnabled="{Binding SelectedBackupJob, Converter={StaticResource NullToBoolConverter}}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Content="Edit" 
                                    Command="{Binding EditBackupJobCommand}" 
                                    Margin="0,0,5,0" Padding="5"/>
                            
                            <Button Grid.Column="1" Content="Delete" 
                                    Command="{Binding DeleteBackupJobCommand}" 
                                    Margin="5,0,0,0" Padding="5"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5">
            <Button Content="Create New Backup Job" Command="{Binding CreateBackupJobCommand}" Padding="10,5"/>
        </StackPanel>
        
        <!-- Status bar -->
        <Border Grid.Row="3" Background="{Binding IsBusinessSoftwareRunning, Converter={StaticResource BoolToColorConverter}}" 
                BorderBrush="Gray" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="10,5" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>