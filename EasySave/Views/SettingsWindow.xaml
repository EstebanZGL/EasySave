<Window x:Class="EasySave.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.Views"
        mc:Ignorable="d"
        Title="EasySave Settings" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Business Software -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Business Software:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BusinessSoftwareName}" Margin="0,0,10,10"/>
        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseBusinessSoftwareButton_Click" Padding="10,0" Margin="0,0,0,10"/>

        <!-- CryptoSoft Path -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="CryptoSoft Path:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CryptoSoftPath}" Margin="0,0,10,10"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseCryptoSoftButton_Click" Padding="10,0" Margin="0,0,0,10"/>

        <!-- Encryption Extensions -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Encrypt Extensions:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
                 Text="{Binding EncryptionExtensionsString}" 
                 ToolTip="Enter file extensions to encrypt, separated by semicolons (e.g. .txt;.doc;.pdf)"
                 Margin="0,0,0,10"/>

        <!-- Log Format -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Log Format:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="JSON" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=JSON}" Margin="0,0,20,0"/>
            <RadioButton Content="XML" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=XML}"/>
            <TextBlock Foreground="Red" Margin="20,0,0,0" VerticalAlignment="Center" Text="* Requires application restart"/>
        </StackPanel>

        <!-- Max Parallel Jobs -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Parallel Jobs:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <Slider Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                Minimum="1" Maximum="10" 
                Value="{Binding MaxParallelJobs}"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                Margin="0,0,0,10"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="{Binding MaxParallelJobs}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,-15"/>

        <!-- Help Text -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBlock FontWeight="Bold">Notes:</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Business Software: EasySave will pause backups when this application is running</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Encrypt Extensions: File types that will be encrypted using CryptoSoft</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Log Format: Changes to log format require application restart to take effect</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Changes are saved automatically</TextBlock>
        </StackPanel>

        <!-- Close Button -->
        <Button Grid.Row="6" Grid.Column="2" Content="Close" Click="CloseButton_Click" Width="80" Margin="0,10,0,0"/>
    </Grid>
</Window>