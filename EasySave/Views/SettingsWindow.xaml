<Window x:Class="EasySave.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:easyLog="clr-namespace:EasyLog;assembly=EasyLog"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="620"
        Width="800"
        MinHeight="500"
        MinWidth="680"
        MaxHeight="760"
        MaxWidth="980"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="#F6F7F5"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryGreen" Color="#4C805B"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#AFC5B5"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F3F5F3"/>

        <Style TargetType="Border" x:Key="RoundedPanel">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputBoxStyle">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#D0DFD6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="InputComboStyle">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="#D0DFD6"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <Border Style="{StaticResource RoundedPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding GeneralSettingsHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LanguageLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                      Style="{StaticResource InputComboStyle}"
                                      SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Tag="en" Content="{Binding EnglishLanguageText}"/>
                                <ComboBoxItem Tag="fr" Content="{Binding FrenchLanguageText}"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding BusinessSoftwareLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BusinessSoftwareName}" Style="{StaticResource InputBoxStyle}" Margin="0,0,10,10"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="{Binding BrowseButtonText}" Click="BrowseBusinessSoftwareButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CryptoSoftPathLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CryptoSoftPath}" Style="{StaticResource InputBoxStyle}" Margin="0,0,10,10"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="{Binding BrowseButtonText}" Click="BrowseCryptoSoftButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding LogFormatLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,0">
                                <RadioButton Content="JSON" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=JSON}"/>
                                <RadioButton Content="XML" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=XML}"/>
                                <TextBlock Foreground="#D8473C" VerticalAlignment="Center" Text="{Binding RestartRequiredText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoundedPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding ParallelBackupSettingsHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding MaxParallelJobsLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <Slider Minimum="1" Maximum="10"
                                        Value="{Binding MaxParallelJobs}"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"/>
                                <TextBlock Text="{Binding MaxParallelJobs}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LargeFileThresholdLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding LargeFileThresholdDisplay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBoxStyle}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding PriorityExtensionsLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding PriorityExtensionsString}"
                                     Style="{StaticResource InputBoxStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoundedPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding EncryptionSettingsHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding EncryptExtensionsLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding EncryptionExtensionsString}"
                                     Style="{StaticResource InputBoxStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RoundedPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LogCentralizationHeader}" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding EnableCentralizationLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding LogCentralization.IsEnabled}" Margin="0,4,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LogServerUrlLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding LogCentralization.ServerUrl}"
                                     IsEnabled="{Binding LogCentralization.IsEnabled}"
                                     Style="{StaticResource InputBoxStyle}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LogDestinationLabel}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <RadioButton Content="{Binding LocalOnlyText}"
                                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Local}}"
                                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                                             Margin="0,0,0,5"/>
                                <RadioButton Content="{Binding RemoteOnlyText}"
                                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Remote}}"
                                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                                             Margin="0,0,0,5"/>
                                <RadioButton Content="{Binding BothLocalRemoteText}"
                                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Both}}"
                                             IsEnabled="{Binding LogCentralization.IsEnabled}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource RoundedPanel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Text="{Binding NotesLabel}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding BusinessSoftwareNote}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding MaxParallelJobsNote}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding LargeFileThresholdNote}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding PriorityExtensionsNote}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding EncryptExtensionsNote}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding LogCentralizationNote}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding ChangesNote}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10,5"
                CornerRadius="12"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                Background="#ECF1EC">
            <TextBlock Text="{Binding RestartRequiredText}" Foreground="#D8473C" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
