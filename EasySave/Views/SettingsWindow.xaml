<Window x:Class="EasySave.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:easyLog="clr-namespace:EasyLog;assembly=EasyLog"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="700"
        Width="720"
        Background="#F6F7F5"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding GeneralSettingsHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LanguageLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                      SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag"
                      Margin="0,0,0,10"
                      MinHeight="30">
                <ComboBoxItem Tag="en" Content="{Binding EnglishLanguageText}"/>
                <ComboBoxItem Tag="fr" Content="{Binding FrenchLanguageText}"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding BusinessSoftwareLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BusinessSoftwareName}" Margin="0,0,10,10"/>
            <Button Grid.Row="2" Grid.Column="2" Content="{Binding BrowseButtonText}" Click="BrowseBusinessSoftwareButton_Click" Padding="10,0" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding CryptoSoftPathLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CryptoSoftPath}" Margin="0,0,10,10"/>
            <Button Grid.Row="3" Grid.Column="2" Content="{Binding BrowseButtonText}" Click="BrowseCryptoSoftButton_Click" Padding="10,0" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding LogFormatLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="JSON" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=JSON}" Margin="0,0,20,0"/>
                <RadioButton Content="XML" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=XML}"/>
                <TextBlock Foreground="Red" Margin="20,0,0,0" VerticalAlignment="Center" Text="{Binding RestartRequiredText}"/>
            </StackPanel>

            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding ParallelBackupSettingsHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding MaxParallelJobsLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,10">
                <Slider Minimum="1" Maximum="10"
                        Value="{Binding MaxParallelJobs}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"/>
                <TextBlock Text="{Binding MaxParallelJobs}" HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding LargeFileThresholdLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding LargeFileThresholdDisplay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding PriorityExtensionsLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding PriorityExtensionsString}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding EncryptionSettingsHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding EncryptExtensionsLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding EncryptionExtensionsString}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding LogCentralizationHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="{Binding EnableCentralizationLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <CheckBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2"
                      IsChecked="{Binding LogCentralization.IsEnabled}"
                      VerticalAlignment="Center"
                      Margin="0,0,0,10"/>

            <TextBlock Grid.Row="13" Grid.Column="0" Text="{Binding LogServerUrlLabel}" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding LogCentralization.ServerUrl}"
                     IsEnabled="{Binding LogCentralization.IsEnabled}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="14" Grid.Column="0" Text="{Binding LogDestinationLabel}" VerticalAlignment="Top" Margin="0,0,10,10"/>
            <StackPanel Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,10">
                <RadioButton Content="{Binding LocalOnlyText}"
                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Local}}"
                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                             Margin="0,0,0,5"/>
                <RadioButton Content="{Binding RemoteOnlyText}"
                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Remote}}"
                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                             Margin="0,0,0,5"/>
                <RadioButton Content="{Binding BothLocalRemoteText}"
                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Both}}"
                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                             Margin="0,0,0,5"/>
            </StackPanel>

            <StackPanel Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                <TextBlock FontWeight="Bold" Text="{Binding NotesLabel}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding BusinessSoftwareNote}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding MaxParallelJobsNote}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding LargeFileThresholdNote}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding PriorityExtensionsNote}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding EncryptExtensionsNote}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding LogCentralizationNote}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding ChangesNote}"/>
            </StackPanel>

            <Button Grid.Row="16" Grid.Column="2" Content="{Binding CloseButtonText}" Click="CloseButton_Click" Width="100" Margin="0,12,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>
