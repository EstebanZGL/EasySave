<Window x:Class="EasySave.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.Views"
        xmlns:easyLog="clr-namespace:EasyLog;assembly=EasyLog"
        mc:Ignorable="d"
        Title="EasySave Settings" Height="600" Width="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- General Settings Section -->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                       Text="General Settings" 
                       Style="{StaticResource SectionHeaderStyle}"/>

            <!-- Business Software -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Business Software:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BusinessSoftwareName}" Margin="0,0,10,10"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseBusinessSoftwareButton_Click" Padding="10,0" Margin="0,0,0,10"/>

            <!-- CryptoSoft Path -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="CryptoSoft Path:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CryptoSoftPath}" Margin="0,0,10,10"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseCryptoSoftButton_Click" Padding="10,0" Margin="0,0,0,10"/>

            <!-- Log Format -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Log Format:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="JSON" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=JSON}" Margin="0,0,20,0"/>
                <RadioButton Content="XML" IsChecked="{Binding LogFormat, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=XML}"/>
                <TextBlock Foreground="Red" Margin="20,0,0,0" VerticalAlignment="Center" Text="* Requires application restart"/>
            </StackPanel>

            <!-- Parallel Backup Settings Section -->
            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                       Text="Parallel Backup Settings" 
                       Style="{StaticResource SectionHeaderStyle}"/>

            <!-- Max Parallel Jobs -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Max Parallel Jobs:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,10">
                <Slider Minimum="1" Maximum="10" 
                        Value="{Binding MaxParallelJobs}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"/>
                <TextBlock Text="{Binding MaxParallelJobs}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Large File Threshold -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Large File Threshold:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" 
                     Text="{Binding LargeFileThresholdDisplay, UpdateSourceTrigger=PropertyChanged}" 
                     ToolTip="Enter size threshold for large files (e.g. 10MB, 1GB)"
                     Margin="0,0,0,10"/>

            <!-- Priority Extensions -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Priority Extensions:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" 
                     Text="{Binding PriorityExtensionsString}" 
                     ToolTip="Enter file extensions to prioritize, separated by semicolons (e.g. .exe;.dll;.sys)"
                     Margin="0,0,0,10"/>

            <!-- Encryption Settings Section -->
            <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" 
                       Text="Encryption Settings" 
                       Style="{StaticResource SectionHeaderStyle}"/>

            <!-- Encryption Extensions -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Encrypt Extensions:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" 
                     Text="{Binding EncryptionExtensionsString}" 
                     ToolTip="Enter file extensions to encrypt, separated by semicolons (e.g. .txt;.doc;.pdf)"
                     Margin="0,0,0,10"/>

            <!-- Log Centralization Section -->
            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" 
                       Text="Log Centralization Settings" 
                       Style="{StaticResource SectionHeaderStyle}"/>

            <!-- Enable Log Centralization -->
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Enable Centralization:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <CheckBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2"
                      IsChecked="{Binding LogCentralization.IsEnabled}"
                      VerticalAlignment="Center"
                      Margin="0,0,0,10"/>

            <!-- Log Server URL -->
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Log Server URL:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding LogCentralization.ServerUrl}"
                     IsEnabled="{Binding LogCentralization.IsEnabled}"
                     Margin="0,0,0,10"/>

            <!-- Log Destination -->
            <TextBlock Grid.Row="13" Grid.Column="0" Text="Log Destination:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <StackPanel Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,10">
                <RadioButton Content="Local Only" 
                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Local}}"
                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                             Margin="0,0,0,5"/>
                <RadioButton Content="Remote Only" 
                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Remote}}"
                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                             Margin="0,0,0,5"/>
                <RadioButton Content="Both Local and Remote" 
                             IsChecked="{Binding LogCentralization.LogDestination, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static easyLog:LogDestination.Both}}"
                             IsEnabled="{Binding LogCentralization.IsEnabled}"
                             Margin="0,0,0,5"/>
            </StackPanel>

            <!-- Help Text -->
            <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <TextBlock FontWeight="Bold">Notes:</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Business Software: EasySave will pause backups when this application is running</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Max Parallel Jobs: Maximum number of backup jobs that can run simultaneously</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Large File Threshold: Files larger than this size cannot be transferred simultaneously</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Priority Extensions: File types that will be processed before any other files</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Encrypt Extensions: File types that will be encrypted using CryptoSoft</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Log Centralization: Configure where log files are stored (local, remote server, or both)</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">- Changes are saved automatically</TextBlock>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Row="15" Grid.Column="2" Content="Close" Click="CloseButton_Click" Width="80" Margin="0,10,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>