<Window x:Class="EasySave.Views.BackupJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.Views"
        mc:Ignorable="d"
        Title="Backup Job" Height="350" Width="500" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Job Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding JobName}" Margin="0,0,0,10"/>

        <!-- Source Path -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Source Path:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SourcePath}" Margin="0,0,10,10"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseSourceButton_Click" Padding="10,0" Margin="0,0,0,10"/>

        <!-- Target Path -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Path:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetPath}" Margin="0,0,10,10"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseTargetButton_Click" Padding="10,0" Margin="0,0,0,10"/>

        <!-- Backup Type -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Backup Type:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="Complete" IsChecked="{Binding IsCompleteType}" Margin="0,0,15,0"/>
            <RadioButton Content="Differential" IsChecked="{Binding IsDifferentialType}"/>
        </StackPanel>

        <!-- Validation Message -->
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                   Text="{Binding ValidationMessage}" 
                   Foreground="Red" 
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Click="SaveButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="CancelButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>