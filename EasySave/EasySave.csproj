<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AssemblyName>EasySave</AssemblyName>
    <RootNamespace>EasySave</RootNamespace>
    <!-- Configurer la sortie pour utiliser le dossier output à la racine -->
    <OutputPath>..\output</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>Resources\easysave_cloud.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 
  <ItemGroup>
    <None Remove="Resources\easysave_icon.ico" />
  </ItemGroup>
  -->

  <!-- 
